# .env.example - Template for environment variables
# Copy this file to .env and update paths for your environment

# Base directories
GRANT_DATA_DIR=/path/to/your/data
GRANT_PRETRAINED_DIR=/path/to/pretrained
GRANT_OUTPUT_DIR=/path/to/outputs

# Model paths
GRANT_BERT_PATH=/path/to/bert-base-uncased
GRANT_LLM_PATH=/path/to/llm_weight

# Checkpoint paths
GRANT_POINT_ENCODER=/path/to/pointcloud_encoder.ckpt
GRANT_CHECKPOINT=/path/to/GRANT.ckpt

# Optional: Cluster-specific library paths
# LD_LIBRARY_PATH=/custom/lib/path

# Optional: Override specific dataset paths
# GRANT_SCANREFER_PATH=/custom/scanrefer.json